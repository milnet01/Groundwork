# shellcheck shell=bash
# The AppImage build's tools, pinned by release and digest. The digests
# were taken from the files downloaded on 2026-10-02. To bump one: change
# the release, download it, and replace the digest.
#
# Plain KEY=value only.

LINUXDEPLOY_RELEASE=1-alpha-20251107-1
LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d

LINUXDEPLOY_QT_RELEASE=1-alpha-20250213-1
LINUXDEPLOY_QT_SHA256=15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724

# The AppImage runtime, given to appimagetool so it downloads nothing
# during the build: left to fetch it, the first build stalled for 40
# minutes on that download (2026-10-02). A dated release, not the moving
# "continuous" tag.
RUNTIME_RELEASE=20251108
RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# The oldest supported system (docs/design.md, The stack).
BUILD_IMAGE=registry.opensuse.org/opensuse/leap:16.0
