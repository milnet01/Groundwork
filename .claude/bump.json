{
  "$about": "The release recipe read by cut-release. The program takes its version from PROJECT_VERSION through the GROUNDWORK_VERSION define. The RPM spec's Version: and the OBS _service tag move with it, because packaging/obs/obs-submit.sh refuses them out of step (GRND-0031).",
  "version_source": "CMakeLists.txt",
  "version_pattern": "project\\(groundwork VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)",
  "files": [
    {
      "path": "CMakeLists.txt",
      "pattern": "project(groundwork VERSION {OLD} LANGUAGES CXX)",
      "replace": "project(groundwork VERSION {NEW} LANGUAGES CXX)"
    },
    {
      "path": "packaging/opensuse/groundwork.spec",
      "pattern": "Version:        {OLD}",
      "replace": "Version:        {NEW}"
    },
    {
      "path": "packaging/obs/_service",
      "pattern": "<param name=\"revision\">v{OLD}</param>",
      "replace": "<param name=\"revision\">v{NEW}</param>"
    }
  ],
  "tag": "v{NEW}"
}
