# shellcheck shell=bash

# The versions of the gate's external tools. Sourced by BOTH
# .github/workflows/ci.yml (which installs them) and scripts/local-ci.sh
# (which checks what it found matches). One file, so the two sides cannot
# name different versions.
#
# WHY: a gate is its tools, not just its steps. In LocalWebServerManager the
# local copy (0.11.0) of the shell linter passed a file that the runner's apt
# copy (0.9) failed, and every push that day went red while the local run was
# green. (No comment line here may start with the linter's own name: it reads
# that as a directive and refuses the file.)
#
# TO BUMP ONE: change the version and its digest here, run
# ./scripts/local-ci.sh, and install the same version locally.
#
# Plain KEY=value only: no expansion, quoting or logic.

# Digest of shellcheck-v<version>.linux.x86_64.tar.xz from the project's
# GitHub release. The version says which file to ask for; the digest checks
# what came back.
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# Digest of actionlint_<version>_linux_amd64.tar.gz, matching the release's
# own checksums file. actionlint also runs shellcheck over every `run:` block.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
